{
  // ==============================================================================
  // ECCI Growth OS — Enterprise Cloudflare Wrangler Configuration (JSONC)
  // ==============================================================================
  // Purpose: Configuration manifest for Cloudflare Workers Builds & Next.js (@opennextjs/cloudflare).
  // Configures main entry worker, static assets directory, D1, KV, R2, Queues,
  // Durable Objects, Vectorize, Workers AI, Browser Rendering, and Analytics.
  // ==============================================================================

  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ecci-growth-os",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "public",
    "binding": "ASSETS"
  },

  // Performance & Edge Routing Optimization
  "placement": {
    "mode": "smart"
  },

  // Observability & Telemetry Logging
  "observability": {
    "enabled": true
  },

  // Production Non-Secret Environment Variables
  "vars": {
    "APP_NAME": "ECCI Growth OS",
    "COMPANY_NAME": "ECCI Growth",
    "APP_ENV": "production",
    "APP_VERSION": "1.0.0",
    "NODE_ENV": "production",
    "API_VERSION": "v1",
    "DEFAULT_LOCALE": "en-US",
    "DEFAULT_TIMEZONE": "UTC",
    "ENABLE_ANALYTICS": "true",
    "ENABLE_AI": "true",
    "ENABLE_EMAILS": "true",
    "ENABLE_SOCIAL_AUTOMATION": "true",
    "ENABLE_BUILDER_PANEL": "true",
    "ENABLE_CAMPAIGNS": "true",
    "ENABLE_VECTOR_SEARCH": "true",
    "ENABLE_WORKFLOWS": "true",
    "NEXT_PUBLIC_APP_NAME": "ECCI Growth OS",
    "NEXT_PUBLIC_APP_ENV": "production",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "ai-studio-eccigrowthos"
  },

  // Expected Production Secrets (To be provisioned via CLI: `wrangler secret put <NAME>`):
  // - OPENAI_API_KEY
  // - GEMINI_API_KEY
  // - ANTHROPIC_API_KEY
  // - META_APP_SECRET
  // - META_ACCESS_TOKEN
  // - GOOGLE_CLIENT_SECRET
  // - GOOGLE_API_KEY
  // - GOOGLE_MAPS_KEY
  // - RESEND_API_KEY
  // - SENDGRID_API_KEY
  // - MAILGUN_API_KEY
  // - STRIPE_SECRET_KEY
  // - PAYPAL_CLIENT_SECRET
  // - CLOUDFLARE_API_TOKEN
  // - JWT_SECRET
  // - ENCRYPTION_KEY
  // - WEBHOOK_SECRET
  // - SUPABASE_SERVICE_ROLE_KEY
  // - NOTION_API_KEY
  // - SLACK_BOT_TOKEN

  // 1. D1 Database — Production Relational Storage
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ecci-db-prod",
      "database_id": "<YOUR_PRODUCTION_D1_DATABASE_ID>"
    }
  ],

  // 2. KV Namespaces — Edge Caching & State Management
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "<YOUR_PRODUCTION_CACHE_KV_ID>"
    },
    {
      "binding": "SESSIONS",
      "id": "<YOUR_PRODUCTION_SESSIONS_KV_ID>"
    },
    {
      "binding": "CONFIG",
      "id": "<YOUR_PRODUCTION_CONFIG_KV_ID>"
    }
  ],

  // 3. R2 Buckets — Asset Storage & Analytics Reports
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "ecci-assets-prod"
    },
    {
      "binding": "REPORTS",
      "bucket_name": "ecci-reports-prod"
    }
  ],

  // 4. Queues — Background Job Producer & Consumer
  "queues": {
    "producers": [
      {
        "queue": "ecci-background-queue-prod",
        "binding": "BACKGROUND_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "ecci-background-queue-prod",
        "max_batch_size": 10,
        "max_batch_timeout": 30
      }
    ]
  },

  // 5. Durable Objects — Real-Time State & Workflow Coordination
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_AGENT",
        "class_name": "AIAgentSessionManager"
      },
      {
        "name": "WORKFLOW_ENGINE",
        "class_name": "WorkflowEngine"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_classes": [
        "AIAgentSessionManager",
        "WorkflowEngine"
      ]
    }
  ],

  // 6. Vectorize Index — Semantic Embedding Search
  "vectorize": [
    {
      "binding": "VECTOR_INDEX",
      "index_name": "ecci-vector-index-prod"
    }
  ],

  // 7. Workers AI — Native ML & AI Models Inferences
  "ai": {
    "binding": "AI"
  },

  // 8. Browser Rendering — Headless Browser Scraping & PDFs
  "browser": {
    "binding": "BROWSER"
  },

  // 9. Analytics Engine — Enterprise Telemetry Datasets
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "ecci_analytics_prod"
    }
  ],

  // Multi-Stage Environment Isolation
  "env": {
    "dev": {
      "name": "ecci-growth-os-dev",
      "routes": [
        {
          "pattern": "dev.eccigrowthos.com/*",
          "zone_name": "eccigrowthos.com"
        }
      ],
      "vars": {
        "APP_NAME": "ECCI Growth OS [DEV]",
        "COMPANY_NAME": "ECCI Growth Dev",
        "APP_ENV": "development",
        "APP_VERSION": "1.0.0-dev",
        "NODE_ENV": "development",
        "API_VERSION": "v1",
        "DEFAULT_LOCALE": "en-US",
        "DEFAULT_TIMEZONE": "UTC",
        "ENABLE_ANALYTICS": "false",
        "ENABLE_AI": "true",
        "ENABLE_EMAILS": "false",
        "ENABLE_SOCIAL_AUTOMATION": "false",
        "ENABLE_BUILDER_PANEL": "true",
        "ENABLE_CAMPAIGNS": "true",
        "ENABLE_VECTOR_SEARCH": "true",
        "ENABLE_WORKFLOWS": "true",
        "NEXT_PUBLIC_APP_NAME": "ECCI Growth OS (Dev)",
        "NEXT_PUBLIC_APP_ENV": "development"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ecci-db-dev",
          "database_id": "<YOUR_DEV_D1_DATABASE_ID>"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "<YOUR_DEV_CACHE_KV_ID>"
        },
        {
          "binding": "SESSIONS",
          "id": "<YOUR_DEV_SESSIONS_KV_ID>"
        },
        {
          "binding": "CONFIG",
          "id": "<YOUR_DEV_CONFIG_KV_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSET_BUCKET",
          "bucket_name": "ecci-assets-dev"
        },
        {
          "binding": "REPORTS",
          "bucket_name": "ecci-reports-dev"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "ecci-background-queue-dev",
            "binding": "BACKGROUND_QUEUE"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "ecci-vector-index-dev"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "ecci_analytics_dev"
        }
      ]
    },

    "staging": {
      "name": "ecci-growth-os-staging",
      "routes": [
        {
          "pattern": "staging.eccigrowthos.com/*",
          "zone_name": "eccigrowthos.com"
        }
      ],
      "vars": {
        "APP_NAME": "ECCI Growth OS [STAGING]",
        "COMPANY_NAME": "ECCI Growth Staging",
        "APP_ENV": "staging",
        "APP_VERSION": "1.0.0-rc",
        "NODE_ENV": "production",
        "API_VERSION": "v1",
        "DEFAULT_LOCALE": "en-US",
        "DEFAULT_TIMEZONE": "UTC",
        "ENABLE_ANALYTICS": "true",
        "ENABLE_AI": "true",
        "ENABLE_EMAILS": "true",
        "ENABLE_SOCIAL_AUTOMATION": "true",
        "ENABLE_BUILDER_PANEL": "true",
        "ENABLE_CAMPAIGNS": "true",
        "ENABLE_VECTOR_SEARCH": "true",
        "ENABLE_WORKFLOWS": "true",
        "NEXT_PUBLIC_APP_NAME": "ECCI Growth OS (Staging)",
        "NEXT_PUBLIC_APP_ENV": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "ecci-db-staging",
          "database_id": "<YOUR_STAGING_D1_DATABASE_ID>"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE",
          "id": "<YOUR_STAGING_CACHE_KV_ID>"
        },
        {
          "binding": "SESSIONS",
          "id": "<YOUR_STAGING_SESSIONS_KV_ID>"
        },
        {
          "binding": "CONFIG",
          "id": "<YOUR_STAGING_CONFIG_KV_ID>"
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSET_BUCKET",
          "bucket_name": "ecci-assets-staging"
        },
        {
          "binding": "REPORTS",
          "bucket_name": "ecci-reports-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "queue": "ecci-background-queue-staging",
            "binding": "BACKGROUND_QUEUE"
          }
        ]
      },
      "vectorize": [
        {
          "binding": "VECTOR_INDEX",
          "index_name": "ecci-vector-index-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "ANALYTICS",
          "dataset": "ecci_analytics_staging"
        }
      ]
    },

    "production": {
      "name": "ecci-growth-os-prod",
      "routes": [
        {
          "pattern": "api.eccigrowthos.com/*",
          "zone_name": "eccigrowthos.com"
        }
      ]
    }
  }
}
